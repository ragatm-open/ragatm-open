# RAGatm Open Compact — `.env` d'exemple. AUCUNE valeur ci-dessous n'est
# opérationnelle : les champs `__GENERATE__` sont remplis par scripts/gen-secrets.sh, qui écrit
# `.env` en mode 0600. Ne jamais versionner `.env`. Ne jamais réutiliser un mot de passe de
# démonstration : `manage.py check` (config.E003) et gen-secrets.sh les refusent.

# --- Projet / exposition ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=ragatm-compact
# Seul port publié : frontend, boucle locale de l'hôte. Ouvrir http://localhost:18080/
COMPACT_FRONTEND_PORT=18080
# Origine du frontend vue par le navigateur (cookies, liens d'invitation / reset).
FRONTEND_APP_ORIGIN=http://localhost:18080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# --- Secrets (générés) ------------------------------------------------------------------
DJANGO_SECRET_KEY=__GENERATE__
DB_NAME=ragatm
DB_USER=ragatm
DB_PASSWORD=__GENERATE__
REDIS_PASSWORD=__GENERATE__
RAG_OPS_METRICS_TOKEN=__GENERATE__
FEEDBACK_PSEUDONYM_SALT=__GENERATE__
# URL complètes (le mot de passe Redis y est intégré par gen-secrets.sh).
DJANGO_CACHE_URL=redis://:__GENERATE__@redis:6379/1
CELERY_BROKER_URL=redis://:__GENERATE__@redis:6379/0
CELERY_RESULT_BACKEND=redis://:__GENERATE__@redis:6379/0

# --- Provenance de build (facultatif ; vide = `not_reported`, jamais une valeur inventée) --
APP_GIT_SHA=
AI_GATEWAY_BUILD_SHA=
AI_GATEWAY_SOURCE_URL=

# --- Image du reranker TEI (digest qualification interne, variante CPU 1.8) ---------------------
AI_GATEWAY_RERANK_BACKEND_IMAGE_DIGEST=sha256:8de25e75ce39617f17f2f6c77d60a4f75b65e779ed5005420eb1400072a15c1c
# 1 = exécution nominale hors ligne (poids déjà approvisionnés dans le volume tei_data).
TEI_HF_HUB_OFFLINE=1

# --- Budgets mémoire des conteneurs (poste 14 Go : ~8 Go utilisés en charge) -----------
COMPACT_MEM_DB=1g
COMPACT_MEM_REDIS=256m
COMPACT_MEM_BACKEND=1536m
COMPACT_MEM_WORKER=2g
COMPACT_MEM_BEAT=256m
COMPACT_MEM_FRONTEND=512m
COMPACT_MEM_GATEWAY=512m
COMPACT_MEM_OLLAMA=5g
COMPACT_MEM_RERANKER=6g
COMPACT_WORKER_CONCURRENCY=2
OLLAMA_KEEP_ALIVE=5m

# --- Disposition des sources (contextes de build) -----------------------------------------
# Racine du dépôt ragatm-open (défaut : le répertoire parent de compact/).
# RAGATM_OPEN_DIR=..
# Clone du dépôt ai-gateway-open (défaut : à côté de ragatm-open/).
# AI_GATEWAY_OPEN_DIR=../../ai-gateway-open
