# RAGatm Open — configuration NON SECRÈTE du backend, du worker et de beat (profil Compact CPU).
# Les secrets et l'exposition vivent dans `.env` (gen-secrets.sh). Référence des variables :
# sources/ragatm-open/docs/10-reference/configuration.md.

# --- Django --------------------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
DJANGO_MIGRATE=1
DJANGO_COLLECTSTATIC=0
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
# Génération CPU : une réponse streamée peut durer plusieurs minutes.
GUNICORN_TIMEOUT=600

# --- Base de données / stockage --------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
MEDIA_ROOT=/data/media

# --- AI Gateway Open : SEULE voie d'inférence (aucun fournisseur externe, aucun repli) -----
AI_GATEWAY_ENABLED=1
AI_GATEWAY_BASE_URL=http://ai-gateway:8100
AI_GATEWAY_TIMEOUT_SECONDS=300
AI_GATEWAY_EMBEDDINGS_ENABLED=1
AI_GATEWAY_EMBEDDINGS_BASE_URL=http://ai-gateway:8100
AI_GATEWAY_EMBEDDINGS_MODEL=fr-en-retrieval
AI_GATEWAY_EMBEDDINGS_TIMEOUT_SECONDS=120
AI_GATEWAY_MODEL=compact-generation-8
AI_GATEWAY_STREAMING_ENABLED=1
AI_GATEWAY_FALLBACK_ENABLED=0
AI_GATEWAY_FALLBACK_PROVIDER=none
AI_GATEWAY_POOL_HOSTS=

# --- Modèles par défaut des espaces (noms LOGIQUES du registre Gateway Open) ---------------
# Profil initial de qualification fonctionnelle CPU : compact-generation-8 (qwen2.5:1.5b-instruct).
# Le profil 12 Go `compact-generation` (qwen2.5:7b-instruct) n'est JAMAIS un repli : il se
# configure explicitement (compose.gpu-12gb.yml) après installation et qualification.
EMBEDDINGS_PROVIDER=ai_gateway
DEFAULT_RAGSPACE_CHAT_PROVIDER=ollama
DEFAULT_RAGSPACE_CHAT_MODEL=compact-generation-8
DEFAULT_RAGSPACE_EMBEDDING_PROVIDER=ai_gateway
DEFAULT_RAGSPACE_EMBEDDING_MODEL=fr-en-retrieval
# Profil de RÉFÉRENCE comparé à la configuration effective (rag_core.E101) : aligné sur le profil Compact.
EMBEDDINGS_EXPECTED_MODEL=fr-en-retrieval
RAG_EMBEDDING_DIM=768

# --- Reranking local (TEI via Gateway) — réglages CPU ----------------------------------------
RAG_RERANKER_ENABLED=1
RAG_RERANKER_BASE_URL=http://ai-gateway:8100
RAG_RERANKER_MODEL_LOGICAL=rerank-default
# CPU : 20 passages / 20 s (le défaut 40 / 2 s vise un GPU) ; l'échec reste explicite
# (compteurs rag_reranker_*), jamais un fournisseur externe.
RAG_RERANKER_POOL_K=20
RAG_RERANKER_TIMEOUT_SECONDS=20
RAG_RERANKER_FAILURE_POLICY=fail_open_rrf

# --- Ingestion : asynchrone via le worker Celery ---------------------------------------------
RAG_INGEST_ASYNC_DEFAULT=1

# --- Capacités optionnelles : OFF (aucun modèle, aucun worker lourd) -------------------------
DOCUMENT_OCR_ENABLED=0
DOCUMENT_VISUAL_ANALYSIS_ENABLED=0
DOCUMENT_AUDIO_INGEST_ENABLED=0
DOCUMENT_AUDIO_GLOBAL_ENABLED=0
