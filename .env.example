# RAGatm Open — configuration d'exemple (profil Compact, une machine, un compose).
#
# Copier en `.env` et renseigner les secrets. AUCUNE valeur ci-dessous ne désigne une
# infrastructure existante : `ai-gateway`, `db`, `redis` sont les noms de services du
# compose Compact. Aucun fournisseur d'IA externe n'existe dans cette édition :
# toute variable OPENAI_*/ANTHROPIC_*/… présente fait échouer `manage.py check` (config.E009).

# --- Django -----------------------------------------------------------------
# dev | staging | prod (prod exige les gardes ci-dessous)
DJANGO_ENV=dev
# générer une valeur aléatoire longue
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_APP_ORIGIN=http://127.0.0.1:3000

# --- Base de données (PostgreSQL + pgvector) ----------------------------------
DB_NAME=ragatm
DB_USER=ragatm
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Redis (cache, Celery) ----------------------------------------------------
DJANGO_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- AI Gateway Open (seule voie d'inférence) ----------------------------------
AI_GATEWAY_ENABLED=1
AI_GATEWAY_BASE_URL=http://ai-gateway:8100
AI_GATEWAY_EMBEDDINGS_ENABLED=1
AI_GATEWAY_EMBEDDINGS_BASE_URL=http://ai-gateway:8100
# profil LOGIQUE du registre Gateway (768 dims, FR/EN)
AI_GATEWAY_EMBEDDINGS_MODEL=fr-en-retrieval
# nom LOGIQUE du registre Gateway Compact (profil CPU/8 Go)
AI_GATEWAY_MODEL=compact-generation-8
AI_GATEWAY_STREAMING_ENABLED=1
# aucun repli : il n'existe aucun fournisseur de repli
AI_GATEWAY_FALLBACK_ENABLED=0
AI_GATEWAY_FALLBACK_PROVIDER=none
# vide = Gateway jointe directement ; ex. ai-gateway-pool
AI_GATEWAY_POOL_HOSTS=

# --- Embeddings (pipeline gouverné uniquement) --------------------------------
EMBEDDINGS_PROVIDER=ai_gateway
DEFAULT_RAGSPACE_EMBEDDING_PROVIDER=ai_gateway
DEFAULT_RAGSPACE_EMBEDDING_MODEL=fr-en-retrieval
RAG_EMBEDDING_DIM=768

# --- Génération / reranking ---------------------------------------------------
# « modèle local servi par l'AI Gateway »
DEFAULT_RAGSPACE_CHAT_PROVIDER=ollama
DEFAULT_RAGSPACE_CHAT_MODEL=compact-generation-8
RAG_RERANKER_ENABLED=1
RAG_RERANKER_BASE_URL=http://ai-gateway:8100

# --- Capacités optionnelles (OFF en Compact) ----------------------------------
DOCUMENT_OCR_ENABLED=0
DOCUMENT_VISUAL_ANALYSIS_ENABLED=0
DOCUMENT_AUDIO_INGEST_ENABLED=0
DOCUMENT_AUDIO_GLOBAL_ENABLED=0

# --- Stockage ---------------------------------------------------------------
MEDIA_ROOT=/data/media
